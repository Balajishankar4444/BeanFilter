datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Roaster {
  id                  String         @id @default(uuid())
  name                String
  slug                String         @unique
  websiteUrl          String
  logoUrl             String?
  defaultCurrency     String         @default("USD")
  shippingThreshold   Float?         // Subtotal required for free shipping
  baseShippingCost    Float          @default(5.00) // Default flat shipping rate
  syncStatus          String         @default("IDLE") // IDLE, SYNCING, SUCCESS, FAILED
  syncSource          String         @default("SHOPIFY") // SHOPIFY, WOOCOMMERCE, MANUAL
  lastSyncAt          DateTime?
  failedSyncAt        DateTime?
  syncError           String?
  
  // Business Classification & Location
  businessType        String         @default("ROASTER") // ROASTER, RETAILER, SUBSCRIPTION, BRAND, EQUIPMENT
  country             String         @default("United States")
  countryCode         String         @default("US")
  city                String         @default("Unknown")
  
  // Affiliate Verification & Partner Fields
  affiliateTier       String         @default("DIRECTORY") // FEATURED_AFFILIATE, AFFILIATE_VERIFIED, AFFILIATE_PENDING, DIRECTORY
  affiliateStatus     String         @default("unverified") // confirmed, unverified, needs_verification, none
  affiliateNetwork    String?        // Awin, Impact, ShareASale, FlexOffers, Adtraction, CJ, TradeTracker, Direct
  commissionType      String?        // percentage, fixed, mixed
  commissionRate      Float?         // e.g. 10.0 for 10%
  cookieDays          Int?           @default(30)
  averageOrderValue   Float?         // e.g. 75.00
  commercialYieldScore Float         @default(50.0) // Internal yield formula score
  editorialScore       Float         @default(90.0)

  subscriptionAvailable Boolean      @default(false)
  productFeedAvailable Boolean       @default(false)
  affiliateTrackingUrl String?
  verifiedAt          DateTime?
  sourceUrl           String?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  products            Product[]
  shippingRules       ShippingRule[]
  affiliateClicks     AffiliateClick[]
}

model Product {
  id               String               @id @default(uuid())
  roasterId        String
  roaster          Roaster              @relation(fields: [roasterId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  originCountry    String?
  region           String?
  farm             String?              // Farm / Estate name
  producer         String?
  category         String?              // Espresso, Filter, Omni-roast, Decaf, Cold Brew, Instant
  process          String?              // Washed, Natural, Honey, Anaerobic, Carbonic Maceration, Experimental
  roastLevel       String?              // Light, Medium-Light, Medium, Medium-Dark, Dark
  description      String?
  imageUrl         String?
  productUrl       String
  affiliateUrl     String?
  affiliateNetwork String?
  
  // Commerce Graph & Equipment Attributes
  productType      String               @default("COFFEE") // COFFEE, EQUIPMENT, GIFT_BOX, ACCESSORY
  equipmentCategory String?             // GRINDER, ESPRESSO_MACHINE, BREWER, SCALE, KETTLE
  commerceCategory String               @default("BEANS") // BEANS, GRINDER, ESPRESSO_MACHINE, BREWER, KETTLE, SCALE, SUBSCRIPTION, GIFT
  brand            String?              // Baratza, Fellow, Breville, De'Longhi, Gaggia, Rancilio, Acaia, Atlas
  grindType        String?              // Burr, Conical, Flat
  burrSizeMm       Float?               // e.g. 40, 54, 64
  boilerType       String?              // Single, Dual, Thermoblock
  kettleCapacityMl Int?                 // e.g. 900, 1000
  subscriptionFreq String?              // Weekly, Bi-weekly, Monthly
  espressoSuitable Boolean              @default(true)
  editorialRating  Float?               @default(4.8)

  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  variants         Variant[]
  flavorNotes      ProductFlavorNote[]
  affiliateClicks  AffiliateClick[]

  @@unique([roasterId, slug])
  @@index([roasterId])
}

model Variant {
  id           String         @id @default(uuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  weightG      Float          // e.g. 100, 200, 250, 340, 454, 500, 1000
  unitLabel    String?        // e.g. "12 oz", "250g", "16 oz", "1kg", "4 Pack", "10 Count", "1 Box"
  price        Float          // e.g. 18.00
  pricePer100g Float          // (price / weightG) * 100
  isBestValue  Boolean        @default(false)
  sku          String?
  isAvailable  Boolean        @default(true)
  stockQuantity Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  priceHistories  PriceHistory[]
  affiliateClicks AffiliateClick[]
  priceAlerts     PriceAlert[]

  @@index([productId])
}

model FlavorNote {
  id       String               @id @default(uuid())
  name     String               @unique
  slug     String               @unique
  products ProductFlavorNote[]
}

model ProductFlavorNote {
  productId    String
  flavorNoteId String

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  flavorNote FlavorNote @relation(fields: [flavorNoteId], references: [id], onDelete: Cascade)

  @@id([productId, flavorNoteId])
  @@index([productId])
  @@index([flavorNoteId])
}

model PriceHistory {
  id         String   @id @default(uuid())
  variantId  String
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price      Float
  recordedAt DateTime @default(now())

  @@index([variantId])
}

model PriceAlert {
  id          String   @id @default(uuid())
  variantId   String
  variant     Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  email       String
  targetPrice Float
  isTriggered Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([variantId])
}

model ShippingRule {
  id                String   @id @default(uuid())
  roasterId         String
  roaster           Roaster  @relation(fields: [roasterId], references: [id], onDelete: Cascade)
  country           String   @default("US") // 2-letter country code or "ALL"
  postalCodePattern String?  // e.g. regex pattern or prefix
  minOrderSubtotal  Float?   // Threshold for rate to apply (e.g., free above $40)
  shippingCost      Float    // Shipping fee
  currency          String   @default("USD")
  providerType      String   @default("STATIC") // STATIC, SHOPIFY, MANUAL
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([roasterId])
}

model AffiliateClick {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  roasterId  String
  roaster    Roaster  @relation(fields: [roasterId], references: [id], onDelete: Cascade)
  referrer   String?
  clickedAt  DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([roasterId])
}
